+
+int canonical_form_with_certificate_vartime(
+    Fq *out,
+    Fq *T_U,
+    Fq *T_V,
+    Fq *T_W,
+    const Fq *M,
+    const Fq *u1,
+    int n)
+{
+  if (out == NULL || T_U == NULL || T_V == NULL || T_W == NULL ||
+      M == NULL || u1 == NULL || n < 5 || n > TRINE_n)
+    return -1;
+
+  Fq U[n * n], V[n * n], W[n * n];
+  Fq f[n], g[n], h[n];
+  Fq *transformed = malloc(triform_element_count(n) * sizeof(*transformed));
+  if (transformed == NULL)
+    return -1;
+
+  int ret = -1;
+  if (canonical_build_uvw_vartime(U, V, W, M, u1, n) != 0)
+    goto cleanup;
+  triform_action_pullback(transformed, M, U, V, W, n);
+  if (compute_normalization_diagonals(f, g, h, transformed, n) != 0)
+    goto cleanup;
+  apply_normalization(out, transformed, f, g, h, n);
+
+  /* U*diag(f), V*diag(g), W*diag(h): right diagonal scaling scales columns. */
+  for (int row = 0; row < n; row++)
+    for (int col = 0; col < n; col++)
+    {
+      T_U[row * n + col] = GF_mul(U[row * n + col], f[col]);
+      T_V[row * n + col] = GF_mul(V[row * n + col], g[col]);
+      T_W[row * n + col] = GF_mul(W[row * n + col], h[col]);
+    }
+  ret = 0;
+
+cleanup:
+  free(transformed);
+  return ret;
+}
